
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STUDYCONNECT SECURITY RULES
     * Implements role-based access for College and Department Admins.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function getAuthEmail() {
      return (isSignedIn() && request.auth.token.email != null) ? request.auth.token.email.lower() : "no-auth";
    }

    function getUserData() {
      let email = getAuthEmail();
      if (email == "no-auth") return null;
      let path = /databases/$(database)/documents/colleges/study-connect-college/users/$(email);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let email = getAuthEmail();
      // Allow hardcoded admins even if their Firestore doc doesn't exist yet (for bootstrap)
      let isHardcodedAdmin = email in [
        'admin@college.edu',
        'shabu@gmail.com',
        'shahabuddinosaid@gmail.com',
        'shabuddinaw@gmail.com',
        'usaid@gmail.com',
        'fareedu46@gmail.com'
      ];
      let user = getUserData();
      return isSignedIn() && (isHardcodedAdmin || (user != null && user.role == 'admin'));
    }
    
    function isHOD() {
      let user = getUserData();
      return isSignedIn() && user != null && user.role == 'hod';
    }

    function getMyDeptId() {
      let user = getUserData();
      return user != null ? user.departmentId : null;
    }

    function isSystemUninitialized() {
      // Allows initial setup if the college root document doesn't exist
      return !exists(/databases/$(database)/documents/colleges/study-connect-college);
    }

    match /colleges/{collegeId} {
      // Allow public read for institutional identity
      allow get: if true;
      // Allow initial creation if uninitialized, otherwise require admin
      allow write, update: if isSystemUninitialized() || isAdmin();

      match /users/{userId} {
        // Allow public get for login directory check
        allow get: if true; 
        allow list: if isAdmin() || (isSignedIn() && getUserData() != null && getUserData().role in ['faculty', 'hod']);
        
        // HODs can update users if the user IS in their department OR is BEING MOVED to their department
        allow create, update: if isSystemUninitialized() || isAdmin() || (
          isHOD() && (
            getMyDeptId() == resource.data.departmentId || 
            getMyDeptId() == request.resource.data.departmentId
          )
        );
        
        allow delete: if isSystemUninitialized() || isAdmin() || (
          isHOD() && getMyDeptId() == resource.data.departmentId
        );
      }

      match /departments/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getMyDeptId() == id); 
      }
      
      match /classes/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getMyDeptId() == resource.data.departmentId); 
      }
      
      match /courses/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getMyDeptId() == resource.data.departmentId); 
      }
      
      match /academicRecords/{id} {
        allow read: if isSignedIn();
        allow write, update: if isSystemUninitialized() || isAdmin() || isHOD();
      }

      match /studentProfiles/{userId} { 
        allow read: if isSignedIn(); 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && getAuthEmail() == userId.lower()); 
      }
      
      match /facultyProfiles/{userId} { 
        allow read: if isSignedIn(); 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && getAuthEmail() == userId.lower()); 
      }

      match /achievements/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getMyDeptId() == resource.data.departmentId); 
      }
      
      match /events/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getMyDeptId() == resource.data.departmentId); 
      }
    }
  }
}
