rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * STUDYCONNECT SECURITY RULES
     * Implements role-based access for College and Department Admins.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let email = request.auth.token.email.lower();
      let path = /databases/$(database)/documents/colleges/study-connect-college/users/$(email);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let email = request.auth.token.email.lower();
      return isSignedIn() && (
        email == 'admin@college.edu' ||
        email == 'shabu@gmail.com' ||
        email == 'shahabuddinosaid@gmail.com' ||
        (getUserData() != null && getUserData().role == 'admin')
      );
    }
    
    function isHOD() {
      return isSignedIn() && getUserData() != null && getUserData().role == 'hod';
    }

    function isSystemUninitialized() {
      // Allows bootstrap if the master admin records are missing
      return !exists(/databases/$(database)/documents/colleges/study-connect-college/users/shabu@gmail.com) &&
             !exists(/databases/$(database)/documents/colleges/study-connect-college/users/shahabuddinosaid@gmail.com) &&
             !exists(/databases/$(database)/documents/colleges/study-connect-college/users/admin@college.edu);
    }

    match /colleges/{collegeId} {
      allow get: if true;
      allow write, update: if isSystemUninitialized() || isAdmin();

      match /users/{userId} {
        allow get: if true; 
        allow list: if isAdmin() || (isSignedIn() && getUserData() != null && getUserData().role in ['faculty', 'hod']);
        allow create, update, delete: if isSystemUninitialized() || isAdmin() || (isHOD() && getUserData().departmentId == resource.data.departmentId);
      }

      match /departments/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isHOD() && getUserData().departmentId == id); 
      }
      
      match /classes/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && getUserData() != null && getUserData().role in ['faculty', 'hod']); 
      }
      
      match /courses/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin(); 
      }
      
      match /academicRecords/{id} {
        allow read: if isSignedIn();
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && getUserData() != null && getUserData().role in ['faculty', 'hod']);
      }

      match /studentProfiles/{userId} { 
        allow read: if isSignedIn(); 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && request.auth.token.email.lower() == userId.lower()); 
      }
      
      match /facultyProfiles/{userId} { 
        allow read: if isSignedIn(); 
        allow write, update: if isSystemUninitialized() || isAdmin() || (isSignedIn() && request.auth.token.email.lower() == userId.lower()); 
      }

      match /achievements/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin(); 
      }
      
      match /events/{id} { 
        allow read: if true; 
        allow write, update: if isSystemUninitialized() || isAdmin(); 
      }
    }
  }
}